# --- Claude Code local state (never commit) ---
# Convention per https://code.claude.com/docs/en/claude-directory :
# everything under .claude/ is committed EXCEPT these.
**/.claude/settings.local.json
CLAUDE.local.md
.claude/agent-memory-local/
.claude/.credentials.json
.claude/history.jsonl
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/projects/
.claude/plugins/
.claude/logs/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- OS / editor ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
*~

# --- Scratch ---
scratch/
tmp/
*.tmp
*.log

# --- Task material that may carry unscrubbed PII ---
# Session state files ARE tracked on purpose (they sync between laptops),
# but anything dropped in these folders is raw and unreviewed.
inbox_raw/
exports_raw/

# Browser automation artifacts. Page snapshots capture the logged-in Feather UI,
# which includes the account email and person UUIDs. New runs write to
# ~/.claude/playwright-output instead; this covers anything already on disk.
.playwright-mcp/

# --- Captured client material (NEVER commit; this repo is PUBLIC) ---
# p*.txt / t*.txt are raw A/B model completions captured out of the Feather SxS UI.
# They are Microsoft AI's evaluation outputs, not our work product. Publishing them
# is removal trigger #4 (PII or confidential material) in PROJECT_KNOWLEDGE.md §4.
/p*.txt
/t*.txt

# Page snapshots and claim/close check dumps. Same reasoning as .playwright-mcp/ above:
# they capture the logged-in Feather/Vercel UI including the account email and person UUIDs.
/snap-*.yml
/vercel-*.yml
/vercel-*.md
/conv*-check.md
/conv*.png

# --- UI Berry client training docs (NEVER commit; this repo is PUBLIC) ---
# The eleven Learning Hub pages under UI_Berry_3R/ are Microsoft AI's own
# contributor training material, scraped out of the Learning Hub UI. They are
# the client's documents, not our work product, and each one carries the
# account holder's name in the page chrome. Publishing them is removal
# trigger #4 (PII or confidential material). The derived kit in
# UI_Berry_3R/system/ IS tracked: that is ours.
/UI_Berry_3R/*.md

# Loose screenshots dropped in the repo root by earlier runs. Same reasoning as
# .playwright-mcp/: they capture the logged-in Feather/Vercel UI.
/*.png

# Scanned client PDF, same reasoning as the Learning Hub pages above.
/english_annotation/
